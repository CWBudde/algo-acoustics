{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "algo-acoustics scene schema",
  "type": "object",
  "required": ["bandSpec", "sampleRate"],
  "oneOf": [
    {
      "required": ["room"],
      "not": { "required": ["rooms"] }
    },
    {
      "required": ["rooms"],
      "not": { "required": ["room"] }
    }
  ],
  "dependentRequired": {
    "portals": ["rooms"]
  },
  "properties": {
    "room": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["shoebox", "mesh"]
        },
        "shoebox": {
          "type": "object",
          "required": ["width", "depth", "height", "wallMaterials"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "depth": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "origin": { "$ref": "#/$defs/vec3" },
            "wallMaterials": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "meshPath": { "type": "string", "minLength": 1 },
        "mesh": { "$ref": "#/$defs/mesh" },
        "meshMaterial": { "type": "string", "minLength": 1 },
        "triangleMaterials": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "shoebox" } }
          },
          "then": {
            "required": ["shoebox"],
            "not": { "required": ["triangleMaterials"] }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "mesh" } }
          },
          "then": {
            "anyOf": [{ "required": ["meshPath"] }, { "required": ["mesh"] }]
          }
        }
      ],
      "additionalProperties": false
    },
    "rooms": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/properties/room" }
    },
    "portals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["roomIndices", "polygon", "material", "state"],
        "properties": {
          "roomIndices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 }
          },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "items": { "$ref": "#/$defs/vec3" }
          },
          "material": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["open", "closed"] }
        },
        "additionalProperties": false
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "absorptionByBand"],
        "properties": {
          "name": { "type": "string" },
          "absorptionByBand": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "scatteringByBand": {
            "type": "array",
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "scattering": {
            "type": "array",
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "transmissionByBand": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "soundReductionIndex": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": 0 }
          }
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["position", "orientation", "gainDb"],
        "properties": {
          "position": { "$ref": "#/$defs/vec3" },
          "orientation": { "$ref": "#/$defs/quaternion" },
          "gainDb": { "type": "number" },
          "directivity": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["omni", "cardioid"] },
              "axis": { "$ref": "#/$defs/vec3" },
              "orderN": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "receivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["position", "orientation", "type"],
        "properties": {
          "position": { "$ref": "#/$defs/vec3" },
          "orientation": { "$ref": "#/$defs/quaternion" },
          "type": { "type": "string", "enum": ["omni", "binaural"] },
          "hrtf": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["noop", "nearestNeighbor"] },
              "sampleRate": { "type": "integer", "minimum": 1 },
              "grid": { "$ref": "#/$defs/measurementGrid" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "bandSpec": {
      "type": "object",
      "required": ["CenterFreqs", "LowerEdges", "UpperEdges"],
      "properties": {
        "CenterFreqs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "LowerEdges": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "UpperEdges": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "sampleRate": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "vec3": {
      "type": "object",
      "required": ["X", "Y", "Z"],
      "properties": {
        "X": { "type": "number" },
        "Y": { "type": "number" },
        "Z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "quaternion": {
      "type": "object",
      "required": ["W", "X", "Y", "Z"],
      "properties": {
        "W": { "type": "number" },
        "X": { "type": "number" },
        "Y": { "type": "number" },
        "Z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "measurementGrid": {
      "type": "object",
      "properties": {
        "directions": {
          "type": "array",
          "items": { "$ref": "#/$defs/vec3" }
        },
        "leftHrir": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" }
          }
        },
        "rightHrir": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" }
          }
        },
        "delays": {
          "type": "array",
          "items": { "type": "number" }
        },
        "triangles": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "required": ["Triangles"],
      "properties": {
        "Triangles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/triangle" }
        }
      },
      "additionalProperties": false
    },
    "triangle": {
      "type": "object",
      "required": ["V0", "V1", "V2"],
      "properties": {
        "V0": { "$ref": "#/$defs/vec3" },
        "V1": { "$ref": "#/$defs/vec3" },
        "V2": { "$ref": "#/$defs/vec3" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
